@{ ViewData["Title"] = "Alert Center"; }
<div class="page-h"><h4>Alert Center</h4><span class="sub">ATM offline · ticket/incident volume · failure spike · host disconnect · API health</span>
<select id="days" class="form-select form-select-sm ms-auto w-auto"><option value="1">24 h</option><option value="7" selected>7 days</option><option value="30">30 days</option></select>
@if (User.IsInRole("Admin")) { <a class="btn btn-sm btn-outline-secondary" href="/Alerts/Rules"><i class="bi bi-sliders"></i> Rules</a> }</div>
<div class="cardx"><table id="tbl" class="table table-sm w-100"><thead><tr><th>Raised</th><th>Sev</th><th>Type</th><th>Alert</th><th>Notification</th><th>Acknowledged</th><th></th></tr></thead></table></div>
@section Scripts { <script>window.CAN_ACT=@(User.IsInRole("Admin")||User.IsInRole("Operator")?"true":"false");</script><script src="~/js/pages/alerts.js" asp-append-version="true"></script> }
