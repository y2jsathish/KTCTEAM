@model ReportsViewModel
@{ ViewData["Title"] = "Reports"; bool op = User.IsInRole("Admin") || User.IsInRole("Operator"); }
<div class="page-h"><h4>Operational Reports</h4></div>
@if (TempData["Error"] is string e) { <div class="alert alert-danger">@e</div> }
<div class="cardx mb-3"><form id="rf" class="row g-2 align-items-end">
  <div class="col-md-3"><label class="form-label small">Report</label><select id="type" class="form-select form-select-sm">@foreach (var t in Model.Types) { <option value="@t.Key">@t.Value</option> }</select></div>
  <div class="col-md-2"><label class="form-label small">From</label><input id="from" type="datetime-local" class="form-control form-control-sm"/></div>
  <div class="col-md-2"><label class="form-label small">To</label><input id="to" type="datetime-local" class="form-control form-control-sm"/></div>
  <div class="col-md-5"><div class="btn-group btn-group-sm"><button type="button" class="btn btn-outline-primary" id="prev"><i class="bi bi-eye"></i> Preview</button>
   <button type="button" class="btn btn-outline-secondary" data-fmt="2"><i class="bi bi-file-earmark-excel"></i> Excel</button><button type="button" class="btn btn-outline-secondary" data-fmt="1"><i class="bi bi-file-earmark-pdf"></i> PDF</button><button type="button" class="btn btn-outline-secondary" data-fmt="3">CSV</button></div></div>
</form></div>
<div class="cardx mb-3" id="preview" hidden><h6 id="pTitle"></h6><div class="kpis" id="pSum"></div><div class="table-responsive"><table class="table table-sm" id="pTbl"></table></div></div>
<div class="cardx"><h6>Scheduled reports (e-mailed)</h6>
@if (op) {
<form method="post" asp-action="Schedule" class="row g-2 mb-3">
  <div class="col-md-2"><input name="Name" class="form-control form-control-sm" placeholder="Name" required/></div>
  <div class="col-md-2"><select name="ReportType" class="form-select form-select-sm">@foreach (var t in Model.Types) { <option value="@t.Key">@t.Value</option> }</select></div>
  <div class="col-md-1"><select name="Frequency" class="form-select form-select-sm"><option value="1">Daily</option><option value="2">Weekly</option><option value="3">Monthly</option></select></div>
  <div class="col-md-1"><select name="Format" class="form-select form-select-sm"><option value="1">PDF</option><option value="2">Excel</option></select></div>
  <div class="col-md-3"><input name="Recipients" class="form-control form-control-sm" placeholder="a@x.com; b@x.com" required/></div>
  <div class="col-md-2"><input name="FirstRunLocal" type="datetime-local" class="form-control form-control-sm" title="First run (portal time)"/></div>
  <div class="col-md-1"><button class="btn btn-sm btn-primary w-100">Add</button></div></form> }
<table class="table table-sm"><thead><tr><th>Name</th><th>Report</th><th>Frequency</th><th>Format</th><th>Recipients</th><th>Next run (UTC)</th><th>Last run</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var s in Model.Schedules) {
 <tr><td>@s.Name</td><td>@s.ReportType</td><td>@s.Frequency</td><td>@s.Format</td><td>@s.Recipients</td><td>@s.NextRunUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@s.LastRunUtc?.ToString("yyyy-MM-dd HH:mm")</td><td>@(s.Enabled ? s.LastStatus ?? "Scheduled" : "Paused")</td>
 <td>@if (op) {<form method="post" asp-action="ToggleSchedule" class="d-inline"><input type="hidden" name="id" value="@s.Id"/><button class="btn btn-sm btn-outline-secondary">@(s.Enabled ? "Pause" : "Resume")</button></form>
 <form method="post" asp-action="DeleteSchedule" class="d-inline" onsubmit="return confirm('Delete this schedule?')"><input type="hidden" name="id" value="@s.Id"/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>}</td></tr> }
 @if (!Model.Schedules.Any()) { <tr><td colspan="9" class="text-muted">No schedules.</td></tr> }
</tbody></table></div>
@section Scripts { <script src="~/js/pages/reports.js" asp-append-version="true"></script> }
