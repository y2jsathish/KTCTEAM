@{ ViewData["Title"] = "Cash Forecasting"; bool isOp = User.IsInRole("Admin") || User.IsInRole("Operator"); }
<div class="page-h"><h4>Cash Forecasting</h4><span class="sbadge warn" title="Run-out dates, usage and loads are estimates">Estimates</span><span class="sub" id="gen">loading…</span>
  <span class="ms-auto"></span><div class="input-group input-group-sm w-auto" title="A cassette counts as out of cash at or below this share of its capacity. Status, run-out dates, visit dates and loads are recalculated for it. Your choice is remembered in this browser.">
    <span class="input-group-text">Low cash at</span><input id="lowPct" type="number" min="0" max="100" step="0.5" class="form-control" style="width:5rem" aria-label="Low cash threshold, percent of cassette capacity"><span class="input-group-text">% of capacity</span>
    <button class="btn btn-outline-primary" id="lowApply" type="button">Apply</button><button class="btn btn-outline-secondary" id="lowReset" type="button" title="Back to the configured default"><i class="bi bi-arrow-counterclockwise"></i></button></div>
  <select id="fClient" class="form-select form-select-sm w-auto" aria-label="Client"><option value="">All clients</option></select>
  <select id="fStatus" class="form-select form-select-sm w-auto" aria-label="Status"><option value="">All statuses</option><option>Out</option><option>Critical</option><option>Warning</option><option>OK</option><option>No usage data</option></select>
  @if (isOp) { <button class="btn btn-sm btn-outline-secondary" id="recalc" title="Read every ATM's cash units now and recalculate"><i class="bi bi-arrow-clockwise"></i> Recalculate</button> }
</div>
<div class="alert alert-info py-2 small mb-2"><i class="bi bi-info-circle"></i> Cash in the cassettes and the daily cash history are <b>actual</b> KTC data. Usage per day, run-out dates and suggested loads are <b>estimates</b>.
  With less than 2 weeks of history expect a run-out date within ±1 day for roughly 6 to 7 ATMs in 10, improving as the daily snapshots build up. Check the source and confidence of each estimate before acting on it.</div>
<div id="warnings"></div>
<div class="kpis" id="kpis"></div>
<div class="grid2">
  <div class="cardx"><h6>Cash withdrawn per day (actual, all ATMs)</h6><div class="chart-box"><canvas id="cDaily"></canvas></div><div class="small text-muted" id="dailyNote"></div></div>
  <div class="cardx"><h6>Visit soon (estimated run-out within 3 days)</h6><div id="soon" class="small" style="max-height:260px;overflow:auto"></div></div>
</div>
<div class="cardx"><h6>ATMs by estimated run-out</h6>
  <table id="tbl" class="table table-sm w-100"><thead><tr><th>ATM</th><th>Client</th><th class="text-end">Cash now</th><th>Runs out (est.)</th><th class="text-end">Days left</th><th>Status</th><th>Visit by (est.)</th><th class="text-end">Load to add (est.)</th><th>Usage from</th><th>Confidence</th></tr></thead></table></div>
@section Scripts { <script src="~/js/pages/cash.js" asp-append-version="true"></script> }
