@{ ViewData["Title"] = "Ticket Workbench"; }
<div class="page-h"><h4>Ticket Workbench</h4><span class="sub">auto-refresh 60 s</span></div>
<div id="breachBanner"></div>
<div class="cardx mb-3"><form id="f" class="row g-2">
  <div class="col-6 col-md-2"><input name="atmId" class="form-control form-control-sm" placeholder="ATM ID / name" value="@ViewBag.AtmId"/></div>
  <div class="col-6 col-md-2"><input name="ticketId" class="form-control form-control-sm" placeholder="Ticket ID" value="@ViewBag.TicketId"/></div>
  <div class="col-6 col-md-2"><input name="client" class="form-control form-control-sm" placeholder="Client"/></div>
  <div class="col-6 col-md-2"><input name="from" type="date" class="form-control form-control-sm" title="From"/></div>
  <div class="col-6 col-md-2"><input name="to" type="date" class="form-control form-control-sm" title="To"/></div>
  <div class="col-6 col-md-2"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-search"></i> Search</button></div>
</form></div>
<div class="kpis" id="statusTiles"></div>
<div class="kpis" id="slaTiles"></div>
<div class="cardx"><table id="tbl" class="table table-sm w-100"><thead><tr><th>Ticket</th><th>ATM</th><th>Client</th><th>Status</th><th>Severity</th><th>Created</th><th>Owner</th><th>SLA due</th><th>SLA</th><th>Description</th></tr></thead></table></div>
@section Scripts { <script src="~/js/pages/tickets.js" asp-append-version="true"></script> }
