@model Ktc.Web.Controllers.ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="cardx"><h4>Something went wrong</h4><p class="text-muted">The error was logged. @if (Model.ShowRequestId) {<span>Reference: <code>@Model.RequestId</code></span>}</p><a href="/" class="btn btn-primary btn-sm">Back to dashboard</a></div>
