@{ ViewData["Title"] = "ATM 360"; }
<div class="page-h"><h4 id="title">ATM 360 View</h4><span id="hb"></span><span class="sub" id="sub"></span>
  <button class="btn btn-sm btn-outline-warning ms-auto" id="fav"><i class="bi bi-star"></i> Favorite</button><a class="btn btn-sm btn-outline-secondary" href="/Atm"><i class="bi bi-arrow-left"></i> ATMs</a></div>
<div id="warnings"></div>
<ul class="nav nav-tabs mb-3" id="atmTabs" role="tablist">
  <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" data-tab="overview" type="button" role="tab" aria-controls="tab-overview" aria-selected="true"><i class="bi bi-info-circle"></i> Overview</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-hardware" data-tab="hardware" type="button" role="tab" aria-controls="tab-hardware" aria-selected="false"><i class="bi bi-cpu"></i> Hardware Status <span id="hwFlagged" class="badge rounded-pill text-bg-warning ms-1 d-none" title="Devices not OK"></span></button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-replenishment" data-tab="replenishment" type="button" role="tab" aria-controls="tab-replenishment" aria-selected="false"><i class="bi bi-cash-coin"></i> Replenishment</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ej-counters" data-tab="ej-counters" type="button" role="tab" aria-controls="tab-ej-counters" aria-selected="false"><i class="bi bi-journal-text"></i> EJ Counters</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-app-counters" data-tab="app-counters" type="button" role="tab" aria-controls="tab-app-counters" aria-selected="false"><i class="bi bi-calculator"></i> Application Counters</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-xfs-counters" data-tab="xfs-counters" type="button" role="tab" aria-controls="tab-xfs-counters" aria-selected="false"><i class="bi bi-gear-wide-connected"></i> XFS Counters <span id="xfsFlagged" class="badge rounded-pill text-bg-warning ms-1 d-none" title="Counters at or over threshold"></span></button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-actions" data-tab="actions" type="button" role="tab" aria-controls="tab-actions" aria-selected="false"><i class="bi bi-lightning-charge"></i> Actions</button></li>
</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
<div class="kpis" id="kpis"></div>
<div class="cardx mb-3"><div class="d-flex align-items-center"><h6 class="m-0">General details</h6><span class="small text-muted ms-2" id="genMeta"></span><a class="small ms-auto d-none" id="genMap" target="_blank" rel="noopener"><i class="bi bi-geo-alt"></i> Show on map</a></div>
  <div id="general" class="row g-3 mt-0"><div class="col-12 text-muted small">Loading…</div></div></div>
<div class="grid2">
  <div class="cardx"><h6>Device details</h6><div id="device"></div></div>
  <div class="cardx"><h6>Availability (30 d) &amp; top unavailable reasons</h6><div class="chart-box sm"><canvas id="cReasons"></canvas></div></div>
</div>
<div class="grid2">
  <div class="cardx"><h6>Open &amp; recent incidents</h6><table id="tInc" class="table table-sm w-100"><thead><tr><th>Incident</th><th>Sev</th><th>Opened</th><th>Status</th><th>Description</th></tr></thead></table></div>
  <div class="cardx"><h6>Tickets</h6><table id="tTk" class="table table-sm w-100"><thead><tr><th>Ticket</th><th>Status</th><th>Sev</th><th>Created</th><th>SLA</th></tr></thead></table></div>
</div>
<div class="grid2">
  <div class="cardx"><h6>Recent transactions (24 h)</h6><table id="tTx" class="table table-sm w-100"><thead><tr><th>Time</th><th>Type</th><th>Status</th><th>Resp ms</th><th>Error</th></tr></thead></table></div>
  <div class="cardx"><h6>Latest transaction timeline (EJ, PAN masked)</h6><ul class="tl" id="timeline"></ul><div class="ej-term mt-2" id="ejRaw"></div></div>
</div>
</div>
<div class="tab-pane fade" id="tab-hardware" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="hwMeta"></span><a class="btn btn-sm btn-outline-secondary ms-auto" id="hwAll" href="#"><i class="bi bi-box-arrow-up-right"></i> Open Hardware Status page</a>
    <button class="btn btn-sm btn-outline-secondary" data-hwrefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="hwMsg"></div>
  <div id="hwKpis" class="kpis"></div>
  <div id="hw" class="hw-chips mb-3"><span class="text-muted small">Loading…</span></div>
  <div id="hwModules" class="row g-3"></div>
</div>
<div class="tab-pane fade" id="tab-replenishment" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="repMeta"></span>
    <button class="btn btn-sm btn-outline-secondary ms-auto" data-reprefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="repMsg"></div>
  <div id="repKpis" class="kpis"></div>
  <div id="repBody" class="row g-3"><div class="col-12 text-muted small">Loading…</div></div>
</div>
<div class="tab-pane fade" id="tab-ej-counters" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="ejcMeta"></span>
    <select class="form-select form-select-sm w-auto ms-auto" id="ejcDays" aria-label="Range"><option value="1">Last 24 hours</option><option value="3">Last 3 days</option><option value="7" selected>Last 7 days</option><option value="14">Last 14 days</option><option value="31">Last 31 days</option></select>
    <button class="btn btn-sm btn-outline-secondary" data-ejcrefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="ejcMsg"></div>
  <div id="ejcKpis" class="kpis"></div>
  <div id="ejcBody" class="row g-3"><div class="col-12 text-muted small">Open this tab to read the EJ.</div></div>
</div>
<div class="tab-pane fade" id="tab-app-counters" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="appMeta"></span>
    <span class="ms-auto btn-group btn-group-sm" role="group" aria-label="Export counters"><button class="btn btn-outline-secondary" data-cx="csv"><i class="bi bi-filetype-csv"></i> CSV</button><button class="btn btn-outline-secondary" data-cx="xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</button><button class="btn btn-outline-secondary" data-cx="pdf"><i class="bi bi-file-earmark-pdf"></i> PDF</button></span>
    <button class="btn btn-sm btn-outline-secondary" data-crefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="appMsg"></div>
  <div id="appCounters" class="row g-3"><div class="col-12 text-muted small">Loading…</div></div>
</div>
<div class="tab-pane fade" id="tab-xfs-counters" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="xfsMeta"></span>
    <span class="ms-auto btn-group btn-group-sm" role="group" aria-label="Export counters"><button class="btn btn-outline-secondary" data-cx="csv"><i class="bi bi-filetype-csv"></i> CSV</button><button class="btn btn-outline-secondary" data-cx="xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</button><button class="btn btn-outline-secondary" data-cx="pdf"><i class="bi bi-file-earmark-pdf"></i> PDF</button></span>
    <button class="btn btn-sm btn-outline-secondary" data-crefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="xfsMsg"></div>
  <div id="xfsPick" class="xfs-pick cardx py-2 mb-3" aria-label="Devices to show"></div>
  <div id="xfsKpis" class="kpis"></div>
  <div id="xfsCounters" class="row g-3"><div class="col-12 text-muted small">Loading…</div></div>
</div>
<div class="tab-pane fade" id="tab-actions" role="tabpanel">
  <div class="counter-bar"><span class="small text-muted" id="actMeta"></span>
    <button class="btn btn-sm btn-outline-secondary ms-auto" id="actJson" disabled><i class="bi bi-download"></i> Download command list (JSON)</button>
    <button class="btn btn-sm btn-outline-secondary" data-actrefresh><i class="bi bi-arrow-clockwise"></i> Refresh</button></div>
  <div id="actMode"></div>
  <div id="actMsg"></div>
  <div class="cardx mb-3"><div class="d-flex align-items-center gap-2"><h6 class="m-0"><i class="bi bi-activity"></i> Activity</h6><span class="small text-muted" id="actHistMeta"></span>
      <select class="form-select form-select-sm w-auto ms-auto" id="actDays" aria-label="Range"><option value="1">Last 24 hours</option><option value="3">Last 3 days</option><option value="7" selected>Last 7 days</option><option value="31">Last 31 days</option></select>
      <button class="btn btn-sm btn-outline-secondary" data-acthistrefresh><i class="bi bi-arrow-clockwise"></i></button></div>
    <div id="actHistMsg" class="mt-2"></div>
    <div id="actReboots"></div>
    <div id="actHistory" class="mt-2"><div class="text-muted small">Open this tab to read the ATM's actions.</div></div>
  </div>
  <div class="cardx mb-3"><h6><i class="bi bi-ui-checks-grid"></i> Guided actions</h6><div id="actPlanned" class="row g-2"><div class="col-12 text-muted small">Open this tab to read KTC's command list.</div></div></div>
  <div class="cardx mb-3" id="actRunCard"><h6><i class="bi bi-send"></i> Run a command</h6>
    <div class="row g-2 align-items-end">
      <div class="col-lg-6 col-12"><label class="form-label small mb-1" for="actCmd">Command</label>
        <select class="form-select form-select-sm" id="actCmd" disabled><option>Open this tab to read KTC's command list…</option></select></div>
      <div class="col-lg-6 col-12 small text-muted" id="actCmdInfo"></div>
    </div>
    <form id="actForm" class="mt-2 d-none" novalidate autocomplete="off">
      <div id="actFields" class="row g-2"></div>
      <hr class="my-2">
      <div class="row g-2">
        <div class="col-md-3 col-12"><label class="form-label small mb-1" for="actTicket">Ticket number <span class="text-danger">*</span></label><input class="form-control form-control-sm" id="actTicket" maxlength="40" required></div>
        <div class="col-md-9 col-12"><label class="form-label small mb-1" for="actReason">Reason <span class="text-danger">*</span></label><input class="form-control form-control-sm" id="actReason" maxlength="500" required placeholder="Why this command is needed (card numbers are masked)"></div>
      </div>
      <div id="actFormErr" class="small text-danger mt-1"></div>
      <button type="submit" class="btn btn-sm btn-primary mt-2" id="actReview"><i class="bi bi-shield-check"></i> Review and confirm</button>
    </form>
  </div>
</div>
</div>
<div class="modal fade" id="actConfirm" tabindex="-1" aria-labelledby="actConfirmTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="actConfirmTitle"><i class="bi bi-exclamation-triangle text-warning"></i> Confirm command</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <div id="actSummary"></div>
    <div id="actRisk" class="d-none alert alert-danger py-2 small mt-2"></div>
    <div class="row g-2 mt-1">
      <div class="col-md-6 col-12"><label class="form-label small mb-1" for="actTypeAtm">Type the ATM id to confirm</label><input class="form-control form-control-sm" id="actTypeAtm" autocomplete="off"></div>
      <div class="col-md-6 col-12 d-none" id="actTypeCmdBox"><label class="form-label small mb-1" for="actTypeCmd">Type the command name</label><input class="form-control form-control-sm" id="actTypeCmd" autocomplete="off"></div>
      <div class="col-12 d-none" id="actAckBox"><div class="form-check"><input class="form-check-input" type="checkbox" id="actAck"><label class="form-check-label small" for="actAck">I understand this command can take the ATM out of use or change it, and I have the approval recorded in the ticket.</label></div></div>
    </div>
    <div id="actChecks" class="mt-2"></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-sm btn-outline-primary" id="actCheckBtn"><i class="bi bi-list-check"></i> Run checks</button>
    <button type="button" class="btn btn-sm btn-danger" id="actSendBtn" disabled><i class="bi bi-send"></i> Send to ATM</button></div>
</div></div></div>
<div class="modal fade" id="actFiles" tabindex="-1" aria-labelledby="actFilesTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="actFilesTitle"><i class="bi bi-folder2-open"></i> Files from the ATM</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body"><div class="alert alert-secondary py-2 small"><i class="bi bi-shield-lock"></i> Only text files are opened. Card numbers are masked (first 6 / last 4) and track data is removed before anything is shown or downloaded; binary and compressed files are not opened. Every download is audited.</div>
    <div id="actFileList"></div><div id="actFileView" class="mt-2"></div></div>
</div></div></div>
<div class="modal fade" id="actReboot" tabindex="-1" aria-labelledby="actRebootTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="actRebootTitle"><i class="bi bi-arrow-repeat text-danger"></i> Guided reboot</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <ol class="small mb-2"><li>Wait until no customer transaction is in progress.</li><li>Take the ATM out of service, then check again that it is idle.</li><li>Reboot, and watch the ATM go offline and come back.</li><li>Check the devices, then put the ATM back in service.</li></ol>
    <div class="small text-muted mb-2">If out of service fails, nothing else is sent. If the reboot fails, the ATM is put back in service. If it does not come back, or devices report faults, it stays out of service and an alert is raised.</div>
    <div class="row g-2">
      <div class="col-md-4 col-12"><label class="form-label small mb-1" for="rbTicket">Ticket number <span class="text-danger">*</span></label><input class="form-control form-control-sm" id="rbTicket" maxlength="40"></div>
      <div class="col-md-8 col-12"><label class="form-label small mb-1" for="rbReason">Reason <span class="text-danger">*</span></label><input class="form-control form-control-sm" id="rbReason" maxlength="500"></div>
      <div class="col-md-6 col-12"><label class="form-label small mb-1" for="rbAtm">Type the ATM id to confirm</label><input class="form-control form-control-sm" id="rbAtm" autocomplete="off"></div>
    </div>
    <div id="rbResult" class="mt-2"></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button><button type="button" class="btn btn-sm btn-danger" id="rbStart"><i class="bi bi-arrow-repeat"></i> Start guided reboot</button></div>
</div></div></div>
@section Scripts { <script>window.ATM_ID=@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.AtmId));</script><script src="~/js/pages/atm360.js" asp-append-version="true"></script><script src="~/js/pages/atm-counters.js" asp-append-version="true"></script><script src="~/js/pages/atm-general.js" asp-append-version="true"></script><script src="~/js/pages/atm-replenishment.js" asp-append-version="true"></script><script src="~/js/pages/atm-ej-counters.js" asp-append-version="true"></script><script src="~/js/pages/atm-actions.js" asp-append-version="true"></script><script src="~/js/pages/atm-actions-activity.js" asp-append-version="true"></script> }
