{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/ktc-portal-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "ConnectionStrings": {
    "KtcPortal": "Server=localhost;Database=KtcMonitoringPortal;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": { "Provider": "SqlServer" },
  "Ktc": {
    "BaseUrl": "https://ktc-server.example.local/",
    "UseMock": false,
    "AppName": "KTC_UI",
    "DefaultAuthMode": "DOMAIN",
    "DefaultTokenLifetimeMinutes": 20,
    "TimeoutSeconds": 15,
    "RetryCount": 3,
    "BreakerFailures": 5,
    "BreakerBreakSeconds": 30,
    "AcceptAnyServerCertificate": false,
    "ServiceAccount": { "Username": null, "Password": null, "AuthMode": "DOMAIN" },
    "OfflineMinutes": 60,
    "AtmOnlineMinutes": 10,
    "SeverityMap": { "1": 1, "2": 2, "3": 3, "4": 4 },
    "TicketStatusMap": {},
    "DefaultSlaHours": { "P1": 4, "P2": 8, "P3": 24, "P4": 72 },
    "NearBreachMinutes": 60
  },
  "Portal": {
    "AdminUsers": [],
    "OperatorUsers": [],
    "TimeZoneId": "Asia/Dubai",
    "DashboardRefreshSeconds": 60,
    "EnableBackgroundJobs": true,
    "SeedPostmanOnStartup": true,
    "PostmanSeedFile": "Seed/KTC_REST_API.postman_collection.json"
  },
  "Notifications": {
    "Smtp": { "Host": null, "Port": 587, "UseStartTls": true, "Username": null, "Password": null, "From": "ktc-portal@yourcompany.com" },
    "TeamsWebhookUrl": null,
    "DefaultRecipients": [],
    "PortalBaseUrl": ""
  },
  "DataProtection": { "KeysPath": "" },
  "AllowedHosts": "*"
}
