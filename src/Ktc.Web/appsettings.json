{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/ktc-portal-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "ConnectionStrings": {
    "KtcPortal": "Server=localhost;Database=KtcMonitoringPortal;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": { "Provider": "SqlServer" },
  "Ktc": {
    "BaseUrl": "https://ktc-server.example.local/",
    "UseMock": false,
    "AppName": "KTC_UI",
    "DefaultAuthMode": "DOMAIN",
    "DefaultTokenLifetimeMinutes": 20,
    "TimeoutSeconds": 15,
    "RetryCount": 3,
    "BreakerFailures": 5,
    "BreakerBreakSeconds": 30,
    "AcceptAnyServerCertificate": false,
    "ServiceAccount": { "Username": null, "Password": null, "AuthMode": "DOMAIN" },
    "OfflineMinutes": 60,
    "AtmOnlineMinutes": 10,
    "SeverityMap": { "1": 1, "2": 2, "3": 3, "4": 4 },
    "TicketStatusMap": {},
    "DefaultSlaHours": { "P1": 4, "P2": 8, "P3": 24, "P4": 72 },
    "NearBreachMinutes": 60,
    "CountersEndpoint": "api/v1/Client/{atmId}/Counters",
    "CounterLookbackDays": 7,
    "TransactionCountersEndpoint": "api/v1/HistoricalCounter/ClientTransactionCounters?clientid={atmId}&transactionid={transactionId}",
    "TransactionNotesMax": 300
  },
  "CashForecast": {
    "SnapshotHour": 23,
    "LowNotes": 50,
    "BufferDays": 1,
    "HorizonDays": 14,
    "CoverDays": 7,
    "SafetyStockPct": 20,
    "CassetteCapacity": 2500,
    "ReconcileToleranceMinutes": 120
  },
  "Portal": {
    "AdminUsers": [],
    "OperatorUsers": [],
    "TimeZoneId": "Asia/Dubai",
    "DashboardRefreshSeconds": 60,
    "EnableBackgroundJobs": true,
    "SeedPostmanOnStartup": true,
    "PostmanSeedFile": "Seed/KTC_REST_API.postman_collection.json"
  },
  "Notifications": {
    "Smtp": { "Host": null, "Port": 587, "UseStartTls": true, "Username": null, "Password": null, "From": "ktc-portal@yourcompany.com" },
    "TeamsWebhookUrl": null,
    "DefaultRecipients": [],
    "PortalBaseUrl": ""
  },
  "KtcActions": { "CommandTypesEndpoint": "api/v1/CommandType", "CacheMinutes": 10, "SendEnabled": false, "VerifyTicketInKtc": true, "MinReasonLength": 10, "MaxSendsPerMinute": 5,
    "HighRiskPattern": "emergency.?reboot|shut.?down|rename|run.*script|script.*run|rescue.?image", "BlockedPattern": "",
    "ParametersRoot": "Parameters", "ParameterElement": "Parameter", "ParameterNameAttribute": "Name",
    "Commands": { "Reboot": "KTC_REBOOT", "XfsReset": "", "DeviceReset": "KTC_RESET_DEVICE", "OutOfService": "KTC_SUPERVISOR_ON", "InService": "KTC_SUPERVISOR_OFF" } },
  "DataProtection": { "KeysPath": "" },
  "Disputes": { "LookbackDays": 14, "MaxRows": 2000, "StateNames": {}, "StatusFilters": [ 0, 1 ], "DetailLookupDays": 365 },
  "DisputeWrite": { "Enabled": false, "CommentTable": 13, "AllowStateChange": false, "MinReasonLength": 10, "MaxReasonLength": 500 },
  "TicketWrite": { "Enabled": false, "UseClosedDateCall": true, "CommentTable": 6, "ClosedStatusByte": null, "ManualClosureMode": null, "ForceUpdate": false, "MinCommentLength": 10 },
  "AllowedHosts": "*"
}
