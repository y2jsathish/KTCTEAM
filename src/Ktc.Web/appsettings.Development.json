{
  "Database": {
    "Provider": "InMemory"
  },
  "Ktc": {
    "UseMock": true,
    "TicketStatusMap": { "1": "Open", "2": "Owned", "3": "Dispatched", "4": "Closed", "5": "AutoClosed" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "TicketWrite": { "ClosedStatusByte": 4, "ManualClosureMode": 0 },
  "KtcActions": {
    "Reboot": {
      "IdleSeconds": 20,
      "OfflineAfterSeconds": 12,
      "TickSeconds": 3
    }
  }
}
